[global_config]
  dbus = False
  always_split_with_profile = True
[keybindings]
[profiles]
  [[default]]
    scrollback_infinite = True
    use_system_font = False
    font = Monospace 11
  [[domain0]]
    background_color = "#101820"
    exit_action = hold
    foreground_color = "#D8E9FF"
    scrollback_infinite = True
    use_system_font = False
    font = Monospace 11
  [[player]]
    background_color = "#101A14"
    exit_action = hold
    foreground_color = "#D8FFE3"
    scrollback_infinite = True
    use_system_font = False
    font = Monospace 11
[layouts]
  [[aichallenge-1p]]
    [[[window0]]]
      type = Window
      parent = ""
      order = 0
      position = 0:0
      maximised = True
      fullscreen = False
      size = 1600, 900
      title = AI Challenge - 1 Player
    [[[main_split]]]
      type = VPaned
      parent = window0
      order = 0
      position = 360
      ratio = 0.4
    [[[simulator]]]
      type = Terminal
      parent = control_split
      order = 0
      profile = domain0
      command = /aichallenge/utils/terminator_pane.bash prepared simulator
    [[[control_split]]]
      type = HPaned
      parent = main_split
      order = 0
      position = 960
      ratio = 0.6
    [[[auxiliary_split]]]
      type = HPaned
      parent = control_split
      order = 1
      position = 400
      ratio = 0.625
    [[[free_shell]]]
      type = Terminal
      parent = auxiliary_split
      order = 0
      profile = player
      command = /aichallenge/utils/terminator_pane.bash free-shell 1
    [[[control]]]
      type = Terminal
      parent = auxiliary_split
      order = 1
      profile = domain0
      command = /aichallenge/utils/terminator_pane.bash prepared stop-all
    [[[player1]]]
      type = Terminal
      parent = main_split
      order = 1
      profile = player
      command = /aichallenge/utils/terminator_pane.bash prepared autoware 1
  [[aichallenge-2p]]
