<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="param_file" default="$(find-pkg-share rsu_fusion_net_pytorch)/config/rsu_fusion_net_pytorch.param.yaml"/>
  <arg name="checkpoint_path" default="$(env RSU_FUSION_NET_PYTORCH_CHECKPOINT '')"/>
  <arg name="device" default="auto"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="control_mode" default="ai"/>

  <node pkg="rsu_fusion_net_pytorch"
        exec="ros_node.py"
        name="rsu_fusion_net_pytorch_node"
        output="screen">
    <param from="$(var param_file)"/>
    <param name="model.checkpoint_path" value="$(var checkpoint_path)"/>
    <param name="device" value="$(var device)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="control_mode" value="$(var control_mode)"/>
  </node>
</launch>
