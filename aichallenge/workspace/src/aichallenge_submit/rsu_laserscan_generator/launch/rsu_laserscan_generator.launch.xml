<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="param_file" default="$(find-pkg-share rsu_laserscan_generator)/config/rsu_laserscan_generator.param.yaml"/>
  <arg name="csv_path" default="$(find-pkg-share laserscan_generator)/map/lane.csv"/>

  <node pkg="rsu_laserscan_generator"
        exec="rsu_laserscan_generator_node"
        name="rsu_laserscan_generator_node"
        output="screen">
    <param from="$(var param_file)"/>
    <param name="csv_path" value="$(var csv_path)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
