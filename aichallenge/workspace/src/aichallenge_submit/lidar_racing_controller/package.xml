<?xml version="1.0"?>
<package format="3">
  <name>lidar_racing_controller</name>
  <version>0.1.0</version>
  <description>LiDAR-only PyTorch policy controller for the AI Challenge racing kart</description>

  <maintainer email="tanaka.arata.y5@s.gifu-u.ac.jp">Arata Tanaka</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>autoware_auto_control_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <!-- PyTorch is supplied by the AI Challenge base image's pinned requirements. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
