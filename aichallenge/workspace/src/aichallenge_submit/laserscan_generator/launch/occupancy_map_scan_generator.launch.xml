<launch>
  <arg name="param_file" default="$(find-pkg-share laserscan_generator)/config/occupancy_map_scan_generator_node.param.yaml"/>
  <arg name="map_path" default=""/>
  <arg name="resolution" default="0.05"/>
  <arg name="origin_x" default="0.0"/>
  <arg name="origin_y" default="0.0"/>
  <arg name="map_frame_id" default="map"/>
  <arg name="scan_frame_id" default="base_link"/>
  <arg name="output_topic" default="/virtual_static_scan"/>
  <arg name="timer_hz" default="20.0"/>
  <arg name="num_rays" default="1080"/>
  <arg name="range_min" default="0.05"/>
  <arg name="range_max" default="30.0"/>
  <arg name="occupied_threshold" default="20"/>
  <arg name="use_sim_time" default="true"/>

  <node pkg="laserscan_generator"
        exec="occupancy_map_scan_generator_node"
        name="occupancy_map_scan_generator_node"
        output="screen">
    <param from="$(var param_file)"/>
    <param name="map_path" value="$(var map_path)"/>
    <param name="resolution" value="$(var resolution)"/>
    <param name="origin_x" value="$(var origin_x)"/>
    <param name="origin_y" value="$(var origin_y)"/>
    <param name="map_frame_id" value="$(var map_frame_id)"/>
    <param name="scan_frame_id" value="$(var scan_frame_id)"/>
    <param name="output_topic" value="$(var output_topic)"/>
    <param name="timer_hz" value="$(var timer_hz)"/>
    <param name="num_rays" value="$(var num_rays)"/>
    <param name="range_min" value="$(var range_min)"/>
    <param name="range_max" value="$(var range_max)"/>
    <param name="occupied_threshold" value="$(var occupied_threshold)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
