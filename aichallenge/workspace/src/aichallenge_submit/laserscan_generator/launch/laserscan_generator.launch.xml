<launch>

  <arg name="laserscan_generator_param"  default="$(find-pkg-share laserscan_generator)/config/laserscan_generator_node.param.yaml"/>
  <arg name="csv_path" default="$(find-pkg-share laserscan_generator)/map/lane.csv"/>

  <arg name="use_sim_time" default="true"/>
  <arg name="pose_topic" default="/localization/pose_with_covariance"/>
  <arg name="scan_topic" default="/sensing/virtual_lidar/scan"/>
  <arg name="scan_with_obstacles_topic" default="/sensing/virtual_lidar/scan_with_obstacles"/>
  <arg name="v2x_topic" default="/v2x/vehicle_positions"/>
  <arg name="enable_v2x_obstacles" default="true"/>
  <arg name="lidar_frame_id" default="virtual_lidar"/>
  <arg name="publish_virtual_lidar_tf" default="true"/>
  <arg name="virtual_lidar_parent_frame" default="lidar"/>
  
  <node if="$(var publish_virtual_lidar_tf)"
        pkg="tf2_ros"
        exec="static_transform_publisher"
        name="static_tf_pub_virtual_lidar"
        args="0.0 0.0 0.0 0 0 0 $(var virtual_lidar_parent_frame) $(var lidar_frame_id)"
        >
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  
  <node pkg="laserscan_generator"
        exec="laserscan_generator_node"
        name="laserscan_generator_node"
        output="screen">

    <param from="$(var laserscan_generator_param)"/>
    <param name="csv_path" value="$(var csv_path)"/>
    <param name="v2x_topic" value="$(var v2x_topic)"/>
    <param name="enable_v2x_obstacles" value="$(var enable_v2x_obstacles)"/>
    <param name="lidar_frame_id" value="$(var lidar_frame_id)"/>
    
    <param name="use_sim_time" value="$(var use_sim_time)"/>

    <remap from="/localization/pose_with_covariance" to="$(var pose_topic)"/>
    <remap from="/scan" to="$(var scan_topic)"/>
    <remap from="/scan_with_obstacles" to="$(var scan_with_obstacles_topic)"/>
    
  </node>

</launch>
