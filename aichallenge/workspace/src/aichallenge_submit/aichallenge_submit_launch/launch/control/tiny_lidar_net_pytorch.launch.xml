<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="simulation" default="true"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="vscan_mode" default="$(var simulation)"/>
  <arg name="checkpoint_path" default="$(env TINY_LIDAR_NET_PYTORCH_CHECKPOINT '')"/>
  <arg name="device" default="auto"/>
  <arg name="csv_path" default="$(find-pkg-share laserscan_generator)/map/lane.csv"/>

  <!-- In simulation, provide the ego-vehicle Virtual Scan expected by the policy. -->
  <group if="$(var vscan_mode)">
    <include file="$(find-pkg-share laserscan_generator)/launch/laserscan_generator.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="csv_path" value="$(var csv_path)"/>
      <!-- Keep NPC lane following independent from nearby V2X vehicles. -->
      <arg name="enable_v2x_obstacles" value="false"/>
    </include>
  </group>

  <include file="$(find-pkg-share tiny_lidar_net_pytorch)/launch/tiny_lidar_net_pytorch.launch.xml">
    <arg name="checkpoint_path" value="$(var checkpoint_path)"/>
    <arg name="device" value="$(var device)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="scan_topic" value="/sensing/lidar/scan_without_obstacles"/>
    <arg name="velocity_topic" value="/vehicle/status/velocity_status"/>
    <arg name="control_cmd_topic" value="/control/command/control_cmd"/>
  </include>
</launch>
