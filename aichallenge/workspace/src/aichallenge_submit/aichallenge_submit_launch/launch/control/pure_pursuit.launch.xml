<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="simulation" default="true"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="odometry_topic" default="/localization/kinematic_state"/>
  <arg name="trajectory_topic" default="/planning/scenario_planning/trajectory"/>
  <arg name="control_cmd_topic" default="/control/command/control_cmd"/>
  <arg name="wheel_base" default="1.087"/>
  <arg name="lookahead_gain" default="0.5"/>
  <arg name="lookahead_min_distance" default="3.5"/>

  <let name="steering_tire_angle_gain_var" value="1.50" if="$(var simulation)"/>
  <let name="steering_tire_angle_gain_var" value="1.639" unless="$(var simulation)"/>

  <node pkg="simple_pure_pursuit" exec="simple_pure_pursuit" name="simple_pure_pursuit_node" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="wheel_base" value="$(var wheel_base)"/>
    <param name="use_external_target_vel" value="false"/>
    <param name="external_target_vel" value="10.0"/>
    <param name="lookahead_gain" value="$(var lookahead_gain)"/>
    <param name="lookahead_min_distance" value="$(var lookahead_min_distance)"/>
    <param name="speed_proportional_gain" value="1.0"/>
    <param name="steering_tire_angle_gain" value="$(var steering_tire_angle_gain_var)"/>

    <remap from="input/kinematics" to="$(var odometry_topic)"/>
    <remap from="input/trajectory" to="$(var trajectory_topic)"/>
    <remap from="output/control_cmd" to="$(var control_cmd_topic)"/>
  </node>
</launch>
