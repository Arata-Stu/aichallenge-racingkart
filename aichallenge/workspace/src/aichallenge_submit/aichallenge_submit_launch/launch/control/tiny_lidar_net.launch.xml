<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="vscan_mode" default="true"/>
  <arg name="ckpt_path" default="$(find-pkg-share tiny_lidar_net_controller)/ckpt/tinylidarnet_weights.pth"/>
  <arg name="device" default="auto"/>
  <arg name="model_type" default="tiny_lidar_net"/>
  <arg name="scan_topic" default="/sensing/lidar/scan"/>
  <arg name="scan_with_obstacles_topic" default="/sensing/lidar/scan_with_obstacles"/>
  <arg name="v2x_topic" default="/v2x/vehicle_positions"/>
  <arg name="enable_v2x_obstacles" default="true"/>
  <arg name="lidar_frame_id" default="virtual_lidar"/>
  <arg name="publish_virtual_lidar_tf" default="true"/>
  <arg name="virtual_lidar_parent_frame" default="lidar"/>
  <arg name="csv_path" default="$(find-pkg-share laserscan_generator)/map/lane.csv"/>

  <group if="$(var vscan_mode)">
    <include file="$(find-pkg-share laserscan_generator)/launch/laserscan_generator.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="csv_path" value="$(var csv_path)"/>
      <arg name="scan_topic" value="$(var scan_topic)"/>
      <arg name="scan_with_obstacles_topic" value="$(var scan_with_obstacles_topic)"/>
      <arg name="v2x_topic" value="$(var v2x_topic)"/>
      <arg name="enable_v2x_obstacles" value="$(var enable_v2x_obstacles)"/>
      <arg name="lidar_frame_id" value="$(var lidar_frame_id)"/>
      <arg name="publish_virtual_lidar_tf" value="$(var publish_virtual_lidar_tf)"/>
      <arg name="virtual_lidar_parent_frame" value="$(var virtual_lidar_parent_frame)"/>
    </include>
  </group>

  <include file="$(find-pkg-share tiny_lidar_net_controller)/launch/tiny_lidar_net.launch.xml">
    <arg name="ckpt_path" value="$(var ckpt_path)"/>
    <arg name="device" value="$(var device)"/>
    <arg name="model_type" value="$(var model_type)"/>
    <arg name="scan_topic" value="$(var scan_topic)"/>
    <arg name="control_cmd_topic" value="/control/command/control_cmd"/>
  </include>
</launch>
