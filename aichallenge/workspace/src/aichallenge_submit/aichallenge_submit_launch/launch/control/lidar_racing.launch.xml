<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="scan_topic" default="/sensing/lidar/scan"/>
  <arg name="control_cmd_topic" default="/control/command/control_cmd"/>
  <arg name="model_path"
       default="$(find-pkg-share lidar_racing_controller)/models/policy_torch.pt"/>
  <arg name="manifest_path"
       default="$(find-pkg-share lidar_racing_controller)/models/policy_manifest.json"/>

  <include file="$(find-pkg-share lidar_racing_controller)/launch/lidar_racing_controller.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="scan_topic" value="$(var scan_topic)"/>
    <arg name="control_cmd_topic" value="$(var control_cmd_topic)"/>
    <arg name="model_path" value="$(var model_path)"/>
    <arg name="manifest_path" value="$(var manifest_path)"/>
  </include>
</launch>
