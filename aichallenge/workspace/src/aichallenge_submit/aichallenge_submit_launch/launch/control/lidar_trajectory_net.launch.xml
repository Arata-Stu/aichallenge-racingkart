<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="simulation" default="true"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="vscan_mode" default="true"/>
  <arg name="ckpt_path"
       default="/aichallenge/ml_workspace/lidar_trajectory_net/checkpoints/best_model.pth"/>
  <arg name="device" default="auto"/>
  <arg name="virtual_scan_topic" default="/sensing/virtual_lidar/scan"/>
  <arg name="virtual_scan_with_obstacles_topic"
       default="/sensing/virtual_lidar/scan_with_obstacles"/>
  <arg name="odometry_topic" default="/localization/kinematic_state"/>
  <arg name="path_topic"
       default="/planning/scenario_planning/lidar_trajectory_net/path"/>
  <arg name="debug_path_topic"
       default="/planning/scenario_planning/lidar_trajectory_net/debug_path"/>
  <arg name="trajectory_topic"
       default="/planning/scenario_planning/lidar_trajectory_net/trajectory"/>
  <arg name="control_cmd_topic" default="/control/command/control_cmd"/>
  <arg name="v2x_topic" default="/v2x/vehicle_positions"/>
  <arg name="enable_v2x_obstacles" default="true"/>
  <arg name="csv_path" default="$(find-pkg-share laserscan_generator)/map/lane.csv"/>

  <group if="$(var vscan_mode)">
    <include file="$(find-pkg-share laserscan_generator)/launch/laserscan_generator.launch.xml">
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="csv_path" value="$(var csv_path)"/>
      <arg name="scan_topic" value="$(var virtual_scan_topic)"/>
      <arg name="scan_with_obstacles_topic"
           value="$(var virtual_scan_with_obstacles_topic)"/>
      <arg name="v2x_topic" value="$(var v2x_topic)"/>
      <arg name="enable_v2x_obstacles" value="$(var enable_v2x_obstacles)"/>
    </include>
  </group>

  <include file="$(find-pkg-share lidar_trajectory_net_controller)/launch/lidar_trajectory_net.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="ckpt_path" value="$(var ckpt_path)"/>
    <arg name="device" value="$(var device)"/>
    <arg name="scan_topic" value="$(var virtual_scan_topic)"/>
    <arg name="scan_with_obstacles_topic"
         value="$(var virtual_scan_with_obstacles_topic)"/>
    <arg name="odometry_topic" value="$(var odometry_topic)"/>
    <arg name="path_topic" value="$(var path_topic)"/>
    <arg name="debug_path_topic" value="$(var debug_path_topic)"/>
  </include>

  <node pkg="path_to_trajectory"
        exec="path_to_trajectory_node"
        name="lidar_path_to_trajectory"
        output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="input" to="$(var path_topic)"/>
    <remap from="output" to="$(var trajectory_topic)"/>
  </node>

  <include file="$(find-pkg-share aichallenge_submit_launch)/launch/control/pure_pursuit.launch.xml">
    <arg name="simulation" value="$(var simulation)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="odometry_topic" value="$(var odometry_topic)"/>
    <arg name="trajectory_topic" value="$(var trajectory_topic)"/>
    <arg name="control_cmd_topic" value="$(var control_cmd_topic)"/>
    <arg name="wheel_base" value="1.087"/>
    <arg name="lookahead_gain" value="0.5"/>
    <arg name="lookahead_min_distance" value="2.0"/>
  </include>
</launch>
